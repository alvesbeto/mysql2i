{
    "name": "alvesbeto/mysql2i",
    "description": "Legacy mysql_* functions for PHP 8+, implemented on ext-mysqli (compatibility shim)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/alvesbeto/mysql2i",
    "support": {
        "issues": "https://github.com/alvesbeto/mysql2i/issues",
        "source": "https://github.com/alvesbeto/mysql2i"
    },
    "keywords": [
        "mysql",
        "mysqli",
        "legacy",
        "shim",
        "php8"
    ],
    "authors": [
        {
            "name": "Beto Souza",
            "homepage": "https://github.com/alvesbeto"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-mysqli": "*"
    },
    "autoload": {
        "psr-4": {
            "Mysql2i\\": "src/Mysql2i/"
        },
        "classmap": [
            "src/mysql2i.class.php"
        ],
        "files": [
            "src/mysql2i.func.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
